# ======================================================================
# Jaswanti Residency - Environment Configuration
# ======================================================================
# Copy this file to .env and fill in real values. DO NOT commit .env.
#
# See README.md "Configuration" section for details on each variable.
# ======================================================================

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/jaswanti_residency?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# --- JWT ---
# Base64-encoded secret, at least 64 bytes. Generate with:
#   openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_SECRET_AT_LEAST_64_BYTES

# --- Razorpay (REMOVED — no longer used, kept for reference) ---
# RAZORPAY_API_KEY=
# RAZORPAY_API_SECRET=

# --- Email / SMTP (Gmail App Password) ---
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
